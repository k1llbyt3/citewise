# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Linters and type checkers
.ruff_cache/
.mypy_cache/
.pyright/

# Build artifacts
build/
dist/
*.egg-info/

# Local environment variables and secrets
.env
.env.*
!.env.example

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Project runtime data, uploads, and caches
user_data/
uploads/
output/*.json
data/*.json
!data/.gitkeep

# Evaluation runtime results and temporary caches
evaluation/results/
!evaluation/results/.gitkeep